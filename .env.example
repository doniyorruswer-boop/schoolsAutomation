# ==============================================================
# EduMaktab AI - Umumiy Tizim Muhit Sozlamalari (.env)
# Ushbu faylni asos qilib .env nusxasini yarating: cp .env.example .env
# ==============================================================

# --- BACKEND SOZLAMALARI ---
PROJECT_NAME="EduMaktab AI - O'qituvchi Yordamchisi"
SECRET_KEY="edumaktab-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PORT=8000
HOST=0.0.0.0

# Ma'lumotlar bazasi:
# Standart: avtomatik ravishda backend/schools_auto.db faylidan foydalanadi
DATABASE_URL=sqlite:///./schools_auto.db

# PostgreSQL ga o'tish (ixtiyoriy):
# DATABASE_URL=postgresql://user:password@localhost:5432/schools_auto

# Sun'iy intellekt (Google Gemini API):
# Kalit ixtiyoriy! Agar bo'sh qoldirilsa, tizim 100% bepul rasmiy DTS
# metodik andozalar generatori orqali to'laqonli va cheklovsiz ishlaydi.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Litsenziya va Sinov
TRIAL_ASSESSMENTS_ALLOWED=1

# Dastlabki tayyor PRO sinov kaliti: EDU-TEST-2026-PRO1

# --- FRONTEND SOZLAMALARI ---
VITE_BACKEND_URL=http://localhost:8000
FRONTEND_PORT=3000
