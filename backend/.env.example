# ==============================================================
# EduMaktab AI - Backend Muhit Sozlamalari (.env)
# Ushbu faylni .env nomi bilan nusxalang: cp .env.example .env
# ==============================================================

# Loyiha nomi va xavfsizlik kaliti
PROJECT_NAME="EduMaktab AI - O'qituvchi Yordamchisi"
SECRET_KEY="edumaktab-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Ma'lumotlar bazasi (Boshlang'ich holatda SQLite)
DATABASE_URL="sqlite:///./schools_auto.db"

# Sun'iy Intellekt (Google Gemini API)
# Agar API kalit kiritilmasa ham tizim 100% to'liq va xatosiz ishlaydi (avtomatik metodik andoza generatori orqali)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Litsenziya va Sinov
# Bepul sinov uchun ruxsat etilgan BSB lar soni
TRIAL_ASSESSMENTS_ALLOWED=1
